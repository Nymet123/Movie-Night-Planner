# Upstash Redis credentials
# Get these from https://console.upstash.com after creating a Redis database.
# Copy this file to .env.local and fill in your values.
UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# For local development, use `vercel dev` instead of `npm run dev`
# so that the /api/data route is served alongside Vite:
#   npm i -g vercel
#   vercel link          # connect to your Vercel project
#   vercel dev           # starts Vite + API routes with .env.local loaded
